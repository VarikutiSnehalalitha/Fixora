# ==============================================================================
# FIXNOW 24/7 - PRODUCTION & LOCAL CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# APP CONFIGURATION
NEXT_PUBLIC_APP_NAME="FixNow 24/7"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION
# Connect to your Supabase PostgreSQL instance (Run migrations from supabase/migrations/20261027_init.sql)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PAYMENT GATEWAY (RAZORPAY TEST & PRODUCTION)
RAZORPAY_KEY_ID=rzp_test_FIXNOW247DEMO
RAZORPAY_KEY_SECRET=rzp_secret_FIXNOW247DEMO
RAZORPAY_WEBHOOK_SECRET=whsec_FIXNOW247DEMO

# MAPPING & GEOLOCATION (LEAFLET / MAPBOX / GOOGLE MAPS)
# OpenStreetMap / Leaflet works out of the box with zero external keys required.
# If Mapbox or Google Maps is desired, configure here:
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMS & OTP GATEWAY
SMS_GATEWAY_PROVIDER=development_mock
SMS_GATEWAY_API_KEY=

# REGULATORY & SAFETY
PESO_COMPLIANCE_MODE=strict
ADMIN_ALERT_EMAIL=ops@fixnow247.in
